{
  "name": "portfolio-jefta-supraja",
  "version": "1.0.0",
  "description": "Jefta Supraja Portfolio Website dengan EmailJS Integration",
  "main": "index.html",
  "scripts": {
    "dev": "npm run build && cd dist && python -m http.server 8090",
    "build": "node scripts/build.js",
    "serve": "cd dist && python -m http.server 8090",
    "deploy": "npm run build && netlify deploy --prod --dir=dist",
    "deploy:preview": "npm run build && netlify deploy --dir=dist",
    "deploy:netlify": "netlify deploy --prod --dir=dist",
    "deploy:vercel": "vercel --prod",
    "deploy:github": "gh-pages -d dist"
  },
  "devDependencies": {
    "dotenv": "^16.0.0",
    "fs-extra": "^11.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "keywords": ["portfolio", "jefta-supraja", "full-stack-developer", "emailjs"],
  "author": "Jefta Supraja"
}