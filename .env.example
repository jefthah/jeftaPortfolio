# Environment Variables untuk EmailJS
# Copy file ini ke .env dan isi dengan kredensial EmailJS Anda

# EmailJS Configuration
EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_TEMPLATE_ID=your_template_id_here

# Example:
# EMAILJS_PUBLIC_KEY=rH8K_qJ_yVQpZHpNm
# EMAILJS_SERVICE_ID=service_portfolio
# EMAILJS_TEMPLATE_ID=template_contact